# Copy this file to .env (never commit .env) and fill in your local values.
# Values in your shell environment override this file.

# Password of the local PostgreSQL superuser "postgres". Keep it in single
# quotes so characters like # $ @ are read literally. Kept out of the URLs
# below, so it needs no URL encoding.
PGPASSWORD='change-me'

# Superuser connection used by `pnpm test:db` (each test file creates and drops its own database).
PEOPLELEDGER_DB_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# Schema-owner connection used by `pnpm db roles|status|up|down`.
PEOPLELEDGER_DB_MIGRATION_URL=postgres://postgres@localhost:5432/peopleledger_dev

# ---- Developer console (pnpm dev:setup / pnpm dev) --------------------------
# Developer identity lets the console act as a synthetic user until sign-in
# (IAM-01) exists. The API refuses to start with it in production.
PEOPLELEDGER_ENV=development
PEOPLELEDGER_DEV_AUTH=enabled

# Runtime login users created by `pnpm dev:setup` (passwords are local, dev only).
# The database name must end in _dev and match PEOPLELEDGER_DB_MIGRATION_URL.
PEOPLELEDGER_APP_DB_URL=postgres://pl_dev_app:dev-only-app-password@localhost:5432/peopleledger_dev
PEOPLELEDGER_WORKER_DB_URL=postgres://pl_dev_worker:dev-only-worker-password@localhost:5432/peopleledger_dev
PEOPLELEDGER_PLATFORM_DB_URL=postgres://pl_dev_platform:dev-only-platform-password@localhost:5432/peopleledger_dev

PEOPLELEDGER_API_PORT=4000
PEOPLELEDGER_API_URL=http://localhost:4000
