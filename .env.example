# Copy this file to .env (never commit .env) and fill in your local values.
# Values in your shell environment override this file.

# Password of the local PostgreSQL superuser "postgres". Keep it in single
# quotes so characters like # $ @ are read literally. Kept out of the URLs
# below, so it needs no URL encoding.
PGPASSWORD='change-me'

# Superuser connection used by `pnpm test:db` (each test file creates and drops its own database).
PEOPLELEDGER_DB_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# Schema-owner connection used by `pnpm db roles|status|up|down`.
PEOPLELEDGER_DB_MIGRATION_URL=postgres://postgres@localhost:5432/peopleledger_dev
