{
  "name": "peopleledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PeopleLedger: Bangladesh-first multi-tenant HR, payroll and tax SaaS (modular monolith)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:db",
    "demo:slice": "tsx scripts/vertical-slice.ts",
    "db": "tsx scripts/db.ts",
    "data-contracts": "tsx scripts/generate-data-contracts.ts",
    "traceability": "tsx scripts/generate-traceability.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "build:web": "pnpm --dir apps/web build"
  },
  "devDependencies": {
    "@peopleledger/contracts": "workspace:*",
    "@peopleledger/pay": "workspace:*",
    "@peopleledger/people": "workspace:*",
    "@peopleledger/platform": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
